    {
      "step": "runPhpCode",
      "code": "if (!defined('CLI_SCRIPT')) { define('CLI_SCRIPT', true); }\nrequire('/www/moodle/config.php');\ntry {\n    global $DB;\n\n    $course = $DB->get_record('course', ['shortname' => 'DRIP01']);\n    if (!$course) {\n        throw new \\RuntimeException(\"Course 'DRIP01' was not found.\");\n    }\n    if ((int) $course->id !== 2) {\n        throw new \\RuntimeException(\"Course 'DRIP01' must have ID 2 for the configured landing page; found {$course->id}.\");\n    }\n\n    // The declarative addModule step inserts the quiz record directly and never\n    // creates the initial quiz_sections row that quiz_add_instance() provides;\n    // quiz_start_new_attempt() requires it to build the attempt layout.\n    foreach ($DB->get_records('quiz', ['course' => $course->id]) as $quiz) {\n        if (!$DB->record_exists('quiz_sections', ['quizid' => $quiz->id])) {\n            $DB->insert_record('quiz_sections', (object) ['quizid' => $quiz->id, 'firstslot' => 1, 'heading' => '', 'shufflequestions' => 0]);\n        }\n    }\n    rebuild_course_cache($course->id, true);\n\n    echo \"Provisioned course 'DRIP01' for the Drip release demo.\\n\";\n} catch (\\Throwable $e) {\n    fwrite(STDERR, 'Drip release demo provisioning failed: ' . $e->getMessage() . \"\\n\");\n}\n"
    },
    {
      "step": "setLandingPage",
      "path": "/admin/tool/driprelease/view.php?courseid=2"
    }
  ]
