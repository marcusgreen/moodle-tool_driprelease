{
  "$schema": "https://ateeducacion.github.io/moodle-playground/assets/blueprints/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "moodle": "5.3"
  },
  "landingPage": "/admin/tool/driprelease/view.php?courseid=2",
  "constants": {
    "ADMIN_USER": "admin",
    "ADMIN_PASS": "test",
    "ADMIN_EMAIL": "admin@example.com"
  },
  "steps": [
    {
      "step": "installMoodle",
      "options": {
        "adminUser": "{{ADMIN_USER}}",
        "adminPass": "{{ADMIN_PASS}}",
        "adminEmail": "{{ADMIN_EMAIL}}",
        "siteName": "Drip Release Demo",
        "locale": "en",
        "timezone": "Europe/London"
      }
    },
    {
      "step": "login",
      "username": "{{ADMIN_USER}}"
    },
    {
      "step": "installMoodlePlugin",
      "pluginType": "tool",
      "pluginName": "driprelease",
      "url": "https://github.com/marcusgreen/moodle-tool_driprelease/archive/refs/heads/main.zip"
    },
    {
      "step": "setConfigs",
      "configs": [
        {
          "plugin": "tool_driprelease",
          "name": "sessionlength",
          "value": "7"
        },
        {
          "plugin": "tool_driprelease",
          "name": "activitiespersession",
          "value": "2"
        },
        {
          "plugin": "tool_driprelease",
          "name": "stayavailable",
          "value": "0"
        },
        {
          "plugin": "tool_driprelease",
          "name": "hideunselected",
          "value": "0"
        }
      ]
    },
    {
      "step": "createCategory",
      "name": "Test Courses"
    },
    {
      "step": "createCourse",
      "fullname": "Drip Release Demo Course",
      "shortname": "DRIP01",
      "category": "Test Courses",
      "format": "topics",
      "numsections": 6,
      "summary": "Demo course with one quiz and one page per week, ready to be released on a timed basis with the Drip release tool."
    },
    {
      "step": "createUser",
      "username": "student",
      "password": "test",
      "email": "student@example.com",
      "firstname": "Demo",
      "lastname": "Student"
    },
    {
      "step": "enrolUser",
      "username": "{{ADMIN_USER}}",
      "course": "DRIP01",
      "role": "editingteacher"
    },
    {
      "step": "enrolUser",
      "username": "student",
      "course": "DRIP01",
      "role": "student"
    },
    {
      "step": "addModule",
      "module": "quiz",
      "course": "DRIP01",
      "section": 1,
      "name": "Week 1 quiz",
      "intro": "<p>Quiz for week 1.</p>",
      "preferredbehaviour": "deferredfeedback",
      "browsersecurity": "-",
      "password": "",
      "subnet": "",
      "grade": 10,
      "questionsperpage": 1
    },
    {
      "step": "addModule",
      "module": "page",
      "course": "DRIP01",
      "section": 1,
      "name": "Week 1 reading",
      "intro": "<p>Reading for week 1.</p>",
      "content": "<h3>Week 1 reading</h3><p>Content for week 1 of the course.</p>",
      "contentformat": 1
    },
    {
      "step": "addModule",
